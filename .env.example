# HTTP server address and port.
HOST=127.0.0.1
PORT=3123

# Optional absolute command paths. Leave unset to auto-detect installed tools.
# ADB_PATH=/path/to/android-sdk/platform-tools/adb
# HDC_PATH=/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains/hdc
# FFMPEG_PATH=ffmpeg

# iOS requires WebDriverAgent running on a Mac with a signed developer build.
# Set this to the WDA server address, for example http://127.0.0.1:8100.
WDA_URL=http://127.0.0.1:8100

# scripts/start-ios-wda.sh builds, installs and keeps WDA + the usbmuxd port
# forward alive. Leave WDA_DEVICE_UDID empty when exactly one iPhone is plugged.
# WDA_DEVICE_UDID=00008130-0005641A2632001C
# WDA_DEVELOPMENT_TEAM=XXXXXXXXXX
# WDA_BUNDLE_ID=com.yourname.viewphone.wda
# VIEWPHONE_WDA_PROJECT=/Users/you/wda/WebDriverAgent
# VIEWPHONE_WDA_DERIVED_DATA=/Users/you/Library/Developer/ViewPhone/WDA-derived

# Optional: reuse an existing WDA session. Leave empty to let ViewPhone create one.
WDA_SESSION_ID=

# Larger screenshots are sharper but slower. 0 keeps the device resolution.
ANDROID_SCREENSHOT_MAX_SIZE=0

# Polling is a safe default and works in Safari/Chrome. Lower means smoother.
CLIENT_FRAME_INTERVAL_MS=450

# Optional vision-driven semantic testing. Each action is decided from a fresh
# screenshot, then independently checked at completion. Secrets stay local.
# VISION_MODEL_PROVIDER=openai
# VISION_MODEL_API_KEY=replace-with-your-key
# VISION_MODEL_NAME=your-vision-model
# VISION_MODEL_API_URL=https://your-provider.example/v1/chat/completions
# VISION_MODEL_TIMEOUT_MS=120000
# Retry delays (ms, comma separated) for dropped connections, 429 and 5xx.
# Leave empty to disable the automatic retries.
# VISION_MODEL_RETRY_DELAYS_MS=800,2000
# Exploration needs room: 60 steps covers a page plus its detail pages.
# VISION_MAX_STEPS=60
# VISION_HISTORY_ROUNDS=5

# Anthropic-compatible endpoints can also be supplied through ANTHROPIC_*.
# Do not commit API keys or put them in this example file.

# Optional semantic-test archives. The application creates the database and
# table automatically. Local JSON fallback is used when MySQL is unavailable.
# Copy real credentials to .env.local, which is ignored by Git.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/viewPhone?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=replace-with-your-password
# ARCHIVE_SHARE_TTL_DAYS=30
# Optional storage directory overrides, useful for isolated deployments/tests.
# VIEWPHONE_ARCHIVE_ROOT=/path/to/archive-json
# VIEWPHONE_TEST_RUNS_ROOT=/path/to/test-screenshots
